# Sprawdź ścieżki poleceniami:
# command -v systemctl
# command -v grub-reboot
# Zapisz jako /etc/sudoers.d/99-wolf-control i ustaw chmod 0440.
# Nazwa użytkownika musi być taka sama jak Systems[].SshUser w appsettings.json.
#
# start/stop display-manager pozwala włączać i wyłączać lokalny pulpit bez
# restartowania systemu. Nie dodawaj szerszego uprawnienia do dowolnego
# polecenia systemctl.

admin ALL=(root) NOPASSWD: /usr/bin/systemctl reboot, /usr/bin/systemctl poweroff, /usr/bin/systemctl start display-manager, /usr/bin/systemctl stop display-manager, /usr/bin/grub-reboot *
